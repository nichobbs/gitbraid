{
	"name": "gitbraid",
	"displayName": "GitBraid",
	"description": "Braid multiple branches together — assign files and hunks to branches, commit per-branch, and manage a stacked branch hierarchy from a single workspace",
	"version": "0.1.0",
	"preview": true,
	"publisher": "nichobbs",
	"private": false,
	"license": "MIT",
	"author": {
		"name": "nichobbs"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/nichobbs/gitbraid"
	},
	"homepage": "https://github.com/nichobbs/gitbraid",
	"bugs": {
		"url": "https://github.com/nichobbs/gitbraid/issues"
	},
	"keywords": [
		"git",
		"branch",
		"worktree",
		"stacked branches",
		"branch stack",
		"gitbraid",
		"multi-branch",
		"hunk routing",
		"scm",
		"stacked prs"
	],
	"badges": [],
	"galleryBanner": {
		"color": "#007ACC",
		"theme": "dark"
	},
	"icon": "resources/icon.png",
	"engines": {
		"vscode": "^1.95.0"
	},
	"enabledApiProposals": [
		"scmActionButton"
	],
	"categories": [
		"SCM Providers",
		"Other"
	],
	"activationEvents": [
		"workspaceContains:.git",
		"workspaceContains:.worktrees/gitbraid-config.json",
		"workspaceContains:.worktrees/local-config.json"
	],
	"extensionKind": [
		"workspace"
	],
	"capabilities": {
		"virtualWorkspaces": {
			"supported": false,
			"description": "GitBraid requires local git worktrees on disk."
		},
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "GitBraid runs git commands that can trigger repository hooks."
		}
	},
	"main": "./dist/extension.js",
	"extensionDependencies": [
		"vscode.git"
	],
	"contributes": {
		"walkthroughs": [
			{
				"id": "gitbraid.getStarted",
				"title": "%gitbraid.walkthrough.title%",
				"description": "%gitbraid.walkthrough.description%",
				"steps": [
					{
						"id": "addBranch",
						"title": "Add a branch to the stack",
						"description": "Build a stack of related branches. Run the Add Stack Branch command to create a worktree-backed branch on top of an existing one.\n\n[Add Stack Branch](command:gitbraid.addStackBranch)",
						"media": {
							"image": "resources/walkthrough-add-branch.svg",
							"altText": "Stack view showing two branches"
						}
					},
					{
						"id": "assignFile",
						"title": "Assign a file to a branch",
						"description": "Right-click any file in the Explorer and choose **Assign to branch**, or run the command below.\n\n[Assign File](command:gitbraid.assignFile)",
						"media": {
							"image": "resources/walkthrough-assign-file.svg",
							"altText": "File assigned to branch"
						}
					},
					{
						"id": "makeCommit",
						"title": "Commit to a branch",
						"description": "Each branch in the stack has its own SCM entry. Type a message there and press the commit button, or run the command below.\n\n[Commit Branch](command:gitbraid.scm.commitBranch)",
						"media": {
							"image": "resources/walkthrough-commit.svg",
							"altText": "SCM panel showing per-branch commit"
						}
					},
					{
						"id": "addLayer",
						"title": "Add another layer",
						"description": "Continue stacking branches for independent sets of changes. Use Rebase Branch to keep each layer up-to-date with its parent.\n\n[Rebase Branch](command:gitbraid.rebaseBranch)",
						"media": {
							"image": "resources/walkthrough-rebase.svg",
							"altText": "Stack after rebase"
						}
					}
				]
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "gitbraid",
					"title": "GitBraid",
					"icon": "resources/icon.svg"
				}
			]
		},
		"views": {
			"gitbraid": [
				{
					"id": "gitbraid.stackView",
					"name": "Branch Stack"
				},
				{
					"id": "gitbraid.stackDashboard",
					"name": "Stack Dashboard",
					"type": "webview"
				}
			]
		},
		"commands": [
			{
				"command": "gitbraid.launchWindowForWorktree",
				"title": "Open in New Window",
				"category": "GitBraid",
				"icon": "$(multiple-windows)"
			},
			{
				"command": "gitbraid.lockWorktree",
				"title": "Lock Worktree",
				"category": "GitBraid",
				"icon": "$(lock)"
			},
			{
				"command": "gitbraid.unlockWorktree",
				"title": "Unlock Worktree",
				"category": "GitBraid",
				"icon": "$(unlock)"
			},
			{
				"command": "gitbraid.copyToWorktree",
				"title": "Copy File to Branch Worktree",
				"category": "GitBraid",
				"icon": "$(copy)"
			},
			{
				"command": "gitbraid.moveToWorktree",
				"title": "Move File to Branch Worktree",
				"category": "GitBraid",
				"icon": "$(redo)"
			},
			{
				"command": "gitbraid.stackView.refresh",
				"title": "Refresh Branch Stack",
				"category": "GitBraid",
				"icon": "$(refresh)"
			},
			{
				"command": "gitbraid.focusStackView",
				"title": "Focus Branch Stack View",
				"category": "GitBraid",
				"icon": "$(list-tree)"
			},
			{
				"command": "gitbraid.scm.commitBranch",
				"title": "Commit Branch",
				"category": "GitBraid",
				"icon": "$(check)"
			},
			{
				"command": "gitbraid.scm.refreshAll",
				"title": "Refresh All SCM Providers",
				"category": "GitBraid",
				"icon": "$(refresh)"
			},
			{
				"command": "gitbraid.assignFile",
				"title": "Assign File to Branch",
				"category": "GitBraid",
				"icon": "$(tag)"
			},
			{
				"command": "gitbraid.assignFolder",
				"title": "Assign Folder to Branch",
				"category": "GitBraid",
				"icon": "$(tag)"
			},
			{
				"command": "gitbraid.unassignFile",
				"title": "Unassign File from Branch",
				"category": "GitBraid",
				"icon": "$(tag-remove)"
			},
			{
				"command": "gitbraid.addStackBranch",
				"title": "Add Branch to Stack",
				"category": "GitBraid",
				"icon": "$(git-branch-create)"
			},
			{
				"command": "gitbraid.addScratchWorktree",
				"title": "Add Scratch Area — parking worktree for uncommitted work",
				"category": "GitBraid",
				"icon": "$(pinned)"
			},
			{
				"command": "gitbraid.addVirtualBranch",
				"title": "Add Virtual Branch — no worktree until materialised",
				"category": "GitBraid",
				"icon": "$(cloud)"
			},
			{
				"command": "gitbraid.materialiseVirtualBranch",
				"title": "Materialise Virtual Branch (create worktree)",
				"category": "GitBraid",
				"icon": "$(cloud-download)"
			},
			{
				"command": "gitbraid.discardVirtualBranch",
				"title": "Discard Virtual Branch",
				"category": "GitBraid",
				"icon": "$(trash)"
			},
			{
				"command": "gitbraid.removeStackBranch",
				"title": "Remove Branch from Stack",
				"category": "GitBraid",
				"icon": "$(git-branch-delete)"
			},
			{
				"command": "gitbraid.resetBranch",
				"title": "Reset Branch (Unassign All Files)",
				"category": "GitBraid",
				"icon": "$(discard)"
			},
			{
				"command": "gitbraid.routeHunks",
				"title": "Route Hunks to Assigned Branches",
				"category": "GitBraid",
				"icon": "$(diff)"
			},
			{
				"command": "gitbraid.openResolvedAtTop",
				"title": "Compare to Top of Stack",
				"category": "GitBraid",
				"icon": "$(git-compare)"
			},
			{
				"command": "gitbraid.showCommit",
				"title": "Show Commit Diff",
				"category": "GitBraid",
				"icon": "$(git-commit)"
			},
			{
				"command": "gitbraid.showStackDiff",
				"title": "Show Cumulative Stack Diff",
				"category": "GitBraid",
				"icon": "$(diff-multiple)"
			},
			{
				"command": "gitbraid.openStackDiff",
				"title": "Open PR-Ready Stack Diff",
				"category": "GitBraid",
				"icon": "$(git-pull-request)"
			},
			{
				"command": "gitbraid.copyStackDiagram",
				"title": "Copy Stack Diagram to Clipboard",
				"category": "GitBraid",
				"icon": "$(clippy)"
			},
			{
				"command": "gitbraid.previewRouting",
				"title": "Preview Hunk Routing (Dry Run)",
				"category": "GitBraid",
				"icon": "$(eye)"
			},
			{
				"command": "gitbraid.assignGlob",
				"title": "Assign Files by Glob Pattern",
				"category": "GitBraid",
				"icon": "$(filter)"
			},
			{
				"command": "gitbraid.runDoctor",
				"title": "Run Doctor (Health Check)",
				"category": "GitBraid",
				"icon": "$(pulse)"
			},
			{
				"command": "gitbraid.saveCheckpoint",
				"title": "Save Stack Checkpoint",
				"category": "GitBraid",
				"icon": "$(save)"
			},
			{
				"command": "gitbraid.restoreCheckpoint",
				"title": "Restore Stack Checkpoint",
				"category": "GitBraid",
				"icon": "$(history)"
			},
			{
				"command": "gitbraid.setCommitTemplate",
				"title": "Set Commit Message Template",
				"category": "GitBraid",
				"icon": "$(edit)"
			},
			{
				"command": "gitbraid.exportStackTemplate",
				"title": "Export Stack as Team Template",
				"category": "GitBraid",
				"icon": "$(repo-push)"
			},
			{
				"command": "gitbraid.moveBranchUp",
				"title": "Move Branch Up in Stack",
				"category": "GitBraid",
				"icon": "$(arrow-up)"
			},
			{
				"command": "gitbraid.moveBranchDown",
				"title": "Move Branch Down in Stack",
				"category": "GitBraid",
				"icon": "$(arrow-down)"
			},
			{
				"command": "gitbraid.assignHunk",
				"title": "Assign Hunk to Branch",
				"category": "GitBraid",
				"icon": "$(diff-single)"
			},
			{
				"command": "gitbraid.unassignHunk",
				"title": "Unassign Hunk from Branch",
				"category": "GitBraid",
				"icon": "$(trash)"
			},
			{
				"command": "gitbraid.rebaseBranch",
				"title": "Rebase Branch onto Parent",
				"category": "GitBraid",
				"icon": "$(git-merge)"
			},
			{
				"command": "gitbraid.pushStack",
				"title": "Push Stack",
				"category": "GitBraid",
				"icon": "$(cloud-upload)"
			},
			{
				"command": "gitbraid.resetStacks",
				"title": "Reset All Stacks (remove worktrees, keep main workspace files)",
				"category": "GitBraid",
				"icon": "$(trash)"
			},
			{
				"command": "gitbraid.syncStack",
				"title": "Sync Stack (fetch + rebase each branch)",
				"category": "GitBraid",
				"icon": "$(sync)"
			},
			{
				"command": "gitbraid.openRebaseConflicts",
				"title": "Open Rebase Conflicts",
				"category": "GitBraid",
				"icon": "$(merge)"
			},
			{
				"command": "gitbraid.rebaseAbort",
				"title": "Abort Rebase",
				"category": "GitBraid",
				"icon": "$(close)"
			},
			{
				"command": "gitbraid.rebaseContinue",
				"title": "Continue Rebase",
				"category": "GitBraid",
				"icon": "$(play)"
			},
			{
				"command": "gitbraid.undoLastAssignment",
				"title": "Undo Last Assignment",
				"category": "GitBraid",
				"icon": "$(discard)"
			},
			{
				"command": "gitbraid.redoLastAssignment",
				"title": "Redo Last Assignment",
				"category": "GitBraid",
				"icon": "$(redo)"
			},
			{
				"command": "gitbraid.exportStack",
				"title": "Export Stack (to .gitbraid/stack.json)",
				"category": "GitBraid",
				"icon": "$(export)"
			},
			{
				"command": "gitbraid.importStack",
				"title": "Import Stack (from .gitbraid/stack.json)",
				"category": "GitBraid",
				"icon": "$(cloud-download)"
			},
			{
				"command": "gitbraid.importStackedTool",
				"title": "Import Stack from External Tool…",
				"category": "GitBraid",
				"icon": "$(git-fetch)"
			},
			{
				"command": "gitbraid.refreshPRStatus",
				"title": "Refresh PR Status",
				"category": "GitBraid",
				"icon": "$(sync)"
			},
			{
				"command": "gitbraid.submitStack",
				"title": "Submit / Update Stacked PRs",
				"category": "GitBraid",
				"icon": "$(git-pull-request-create)"
			},
			{
				"command": "gitbraid.mergeStack",
				"title": "Merge Stack via Queue",
				"category": "GitBraid",
				"icon": "$(list-ordered)"
			},
			{
				"command": "gitbraid.absorbHunks",
				"title": "Absorb Hunks Into Owning Commits",
				"category": "GitBraid",
				"icon": "$(git-commit)"
			},
			{
				"command": "gitbraid.stackDashboard.focus",
				"title": "Show Stack Dashboard",
				"category": "GitBraid",
				"icon": "$(graph)"
			},
			{
				"command": "gitbraid.openStackedPR",
				"title": "Open Stacked PR in Browser",
				"category": "GitBraid",
				"icon": "$(link-external)"
			},
			{
				"command": "gitbraid.setGithubToken",
				"title": "Set PR Host Token… (GitHub / GitLab / Bitbucket)",
				"category": "GitBraid",
				"icon": "$(key)"
			},
			{
				"command": "gitbraid.refreshPrReviewComments",
				"title": "Refresh PR Review Comments",
				"category": "GitBraid",
				"icon": "$(comment-discussion)"
			},
			{
				"command": "gitbraid.toggleSingleCommitMode",
				"title": "Toggle Single-Commit Mode",
				"category": "GitBraid",
				"icon": "$(combine)"
			},
			{
				"command": "gitbraid.showUndoLog",
				"title": "Show Undo Log",
				"category": "GitBraid",
				"icon": "$(history)"
			},
			{
				"command": "gitbraid.showActiveFolder",
				"title": "Show Active Folder (multi-root)",
				"category": "GitBraid",
				"icon": "$(folder-active)"
			},
			{
				"command": "gitbraid.setBranchColor",
				"title": "Set Branch Colour",
				"category": "GitBraid",
				"icon": "$(symbol-color)"
			},
			{
				"command": "gitbraid.rehideAssignedFiles",
				"title": "Re-hide Assigned Files",
				"category": "GitBraid",
				"icon": "$(eye-closed)"
			},
			{
				"command": "gitbraid.syncAssignedToWorktrees",
				"title": "Sync Assigned Files to Worktrees",
				"category": "GitBraid",
				"icon": "$(sync)"
			},
			{
				"command": "gitbraid.scm.generateCommitMessage",
				"title": "Generate Commit Message",
				"category": "GitBraid",
				"icon": "$(sparkle)"
			},
			{
				"command": "gitbraid.scm.pushBranch",
				"title": "Push Branch",
				"category": "GitBraid",
				"icon": "$(cloud-upload)"
			},
			{
				"command": "gitbraid.scm.pullBranch",
				"title": "Pull Branch",
				"category": "GitBraid",
				"icon": "$(cloud-download)"
			},
			{
				"command": "gitbraid.scm.syncBranch",
				"title": "Sync Branch (Pull then Push)",
				"category": "GitBraid",
				"icon": "$(sync)"
			},
			{
				"command": "gitbraid.scm.stashBranch",
				"title": "Stash Branch Changes",
				"category": "GitBraid",
				"icon": "$(archive)"
			},
			{
				"command": "gitbraid.scm.stageFile",
				"title": "Stage Changes",
				"category": "GitBraid",
				"icon": "$(add)"
			},
			{
				"command": "gitbraid.scm.unstageFile",
				"title": "Unstage Changes",
				"category": "GitBraid",
				"icon": "$(remove)"
			},
			{
				"command": "gitbraid.scm.stageAll",
				"title": "Stage All Changes",
				"category": "GitBraid",
				"icon": "$(add)"
			},
			{
				"command": "gitbraid.scm.unstageAll",
				"title": "Unstage All Changes",
				"category": "GitBraid",
				"icon": "$(remove)"
			},
			{
				"command": "gitbraid.scm.commitFromInputBox",
				"title": "Commit",
				"category": "GitBraid",
				"icon": "$(check)"
			},
			{
				"command": "gitbraid.scm.commitAndPush",
				"title": "Commit & Push",
				"category": "GitBraid",
				"icon": "$(cloud-upload)"
			},
			{
				"command": "gitbraid.scm.commitAndSync",
				"title": "Commit & Sync",
				"category": "GitBraid",
				"icon": "$(sync)"
			},
			{
				"command": "gitbraid.scm.stageAllGroup",
				"title": "Stage All Changes",
				"category": "GitBraid",
				"icon": "$(add)"
			},
			{
				"command": "gitbraid.scm.unstageAllGroup",
				"title": "Unstage All Changes",
				"category": "GitBraid",
				"icon": "$(remove)"
			},
			{
				"command": "gitbraid.startMcpServer",
				"title": "Start / Stop MCP Server",
				"category": "GitBraid",
				"icon": "$(plug)"
			}
		],
		"viewsWelcome": [
			{
				"view": "gitbraid.stackView",
				"contents": "No branches in your stack yet.\n[Add Branch to Stack](command:gitbraid.addStackBranch)\n[Open Walkthrough](command:workbench.action.openWalkthrough?%22gitbraid.gitbraid%23gitbraid.getStarted%22)",
				"when": "true"
			}
		],
		"menus": {
			"scm/inputBox": [
				{
					"command": "gitbraid.scm.commitFromInputBox",
					"when": "scmProvider =~ /^gitbraid-/"
				}
			],
			"view/title": [
				{
					"command": "gitbraid.addStackBranch",
					"when": "view == gitbraid.stackView",
					"group": "navigation"
				},
				{
					"command": "gitbraid.addVirtualBranch",
					"when": "view == gitbraid.stackView",
					"group": "navigation"
				},
				{
					"command": "gitbraid.addScratchWorktree",
					"when": "view == gitbraid.stackView",
					"group": "navigation"
				},
				{
					"command": "gitbraid.stackView.refresh",
					"when": "view == gitbraid.stackView",
					"group": "navigation"
				},
				{
					"command": "gitbraid.copyStackDiagram",
					"when": "view == gitbraid.stackView",
					"group": "navigation"
				},
				{
					"command": "gitbraid.rehideAssignedFiles",
					"when": "view == gitbraid.stackView",
					"group": "navigation"
				},
				{
					"command": "gitbraid.syncAssignedToWorktrees",
					"when": "view == gitbraid.stackView",
					"group": "navigation"
				},
				{
					"command": "gitbraid.resetStacks",
					"when": "view == gitbraid.stackView",
					"group": "navigation"
				}
			],
			"explorer/context": [
				{
					"command": "gitbraid.assignFile",
					"when": "!explorerResourceIsFolder",
					"group": "gitbraid@1"
				},
				{
					"command": "gitbraid.assignFolder",
					"when": "explorerResourceIsFolder",
					"group": "gitbraid@1"
				},
				{
					"command": "gitbraid.unassignFile",
					"when": "!explorerResourceIsFolder",
					"group": "gitbraid@2"
				},
				{
					"command": "gitbraid.unassignFolder",
					"when": "explorerResourceIsFolder",
					"group": "gitbraid@2"
				},
				{
					"command": "gitbraid.openStackDiff",
					"when": "!explorerResourceIsFolder",
					"group": "gitbraid@3"
				}
			],
			"scm/resourceGroup/context": [
				{
					"command": "gitbraid.scm.stageAllGroup",
					"when": "scmProvider =~ /^gitbraid-/ && scmResourceGroup == changes",
					"group": "inline"
				},
				{
					"command": "gitbraid.scm.unstageAllGroup",
					"when": "scmProvider =~ /^gitbraid-/ && scmResourceGroup == staged",
					"group": "inline"
				}
			],
			"scm/resourceState/context": [
				{
					"command": "gitbraid.scm.stageFile",
					"when": "scmProvider =~ /^gitbraid-/ && scmResourceGroup == changes",
					"group": "inline"
				},
				{
					"command": "gitbraid.scm.unstageFile",
					"when": "scmProvider =~ /^gitbraid-/ && scmResourceGroup == staged",
					"group": "inline"
				},
				{
					"command": "gitbraid.assignFile",
					"when": "scmProvider == git",
					"group": "gitbraid@1"
				},
				{
					"command": "gitbraid.unassignFile",
					"when": "scmProvider == git",
					"group": "gitbraid@2"
				}
			],
			"scm/title": [
				{
					"command": "gitbraid.scm.stageAll",
					"when": "scmProvider =~ /^gitbraid-/",
					"group": "1_scm@0"
				},
				{
					"command": "gitbraid.scm.unstageAll",
					"when": "scmProvider =~ /^gitbraid-/",
					"group": "1_scm@1"
				},
				{
					"command": "gitbraid.scm.generateCommitMessage",
					"when": "scmProvider =~ /^gitbraid-/",
					"group": "1_scm@2"
				},
				{
					"command": "gitbraid.scm.pullBranch",
					"when": "scmProvider =~ /^gitbraid-/",
					"group": "1_scm@3"
				},
				{
					"command": "gitbraid.scm.pushBranch",
					"when": "scmProvider =~ /^gitbraid-/",
					"group": "1_scm@4"
				},
				{
					"command": "gitbraid.scm.syncBranch",
					"when": "scmProvider =~ /^gitbraid-/",
					"group": "1_scm@5"
				},
				{
					"command": "gitbraid.scm.stashBranch",
					"when": "scmProvider =~ /^gitbraid-/",
					"group": "1_scm@6"
				}
			],
			"view/item/context": [
				{
					"command": "gitbraid.launchWindowForWorktree",
					"when": "view == gitbraid.stackView && viewItem == branch",
					"group": "branch@0"
				},
				{
					"command": "gitbraid.lockWorktree",
					"when": "view == gitbraid.stackView && viewItem == branch",
					"group": "branch@1"
				},
				{
					"command": "gitbraid.unlockWorktree",
					"when": "view == gitbraid.stackView && viewItem == branch",
					"group": "branch@2"
				},
				{
					"command": "gitbraid.copyToWorktree",
					"when": "view == gitbraid.stackView && (viewItem == assignedFile || viewItem == floatingFile)",
					"group": "file@1"
				},
				{
					"command": "gitbraid.moveToWorktree",
					"when": "view == gitbraid.stackView && (viewItem == assignedFile || viewItem == floatingFile)",
					"group": "file@2"
				},
				{
					"command": "gitbraid.assignFile",
					"when": "view == gitbraid.stackView && viewItem == floatingFile",
					"group": "inline"
				},
				{
					"command": "gitbraid.unassignFile",
					"when": "view == gitbraid.stackView && viewItem == assignedFile",
					"group": "inline"
				},
				{
					"command": "gitbraid.scm.commitBranch",
					"when": "view == gitbraid.stackView && viewItem == branch",
					"group": "inline"
				},
				{
					"command": "gitbraid.rebaseBranch",
					"when": "view == gitbraid.stackView && viewItem == branch",
					"group": "inline"
				},
				{
					"command": "gitbraid.removeStackBranch",
					"when": "view == gitbraid.stackView && viewItem == branch",
					"group": "inline"
				},
				{
					"command": "gitbraid.moveBranchUp",
					"when": "view == gitbraid.stackView && viewItem == branch",
					"group": "order@1"
				},
				{
					"command": "gitbraid.moveBranchDown",
					"when": "view == gitbraid.stackView && viewItem == branch",
					"group": "order@2"
				},
				{
					"command": "gitbraid.resetBranch",
					"when": "view == gitbraid.stackView && viewItem == branch",
					"group": "branch@1"
				},
				{
					"command": "gitbraid.setBranchColor",
					"when": "view == gitbraid.stackView && viewItem == branch",
					"group": "branch@3"
				},
				{
					"command": "gitbraid.removeStackBranch",
					"when": "view == gitbraid.stackView && viewItem == scratchBranch",
					"group": "inline"
				},
				{
					"command": "gitbraid.resetBranch",
					"when": "view == gitbraid.stackView && viewItem == scratchBranch",
					"group": "scratch@1"
				},
				{
					"command": "gitbraid.materialiseVirtualBranch",
					"when": "view == gitbraid.stackView && viewItem == virtualBranch",
					"group": "inline"
				},
				{
					"command": "gitbraid.discardVirtualBranch",
					"when": "view == gitbraid.stackView && viewItem == virtualBranch",
					"group": "virtual@1"
				},
				{
					"command": "gitbraid.materialiseVirtualBranch",
					"when": "view == gitbraid.stackView && viewItem == virtualBranch",
					"group": "virtual@0"
				}
			]
		},
		"configuration": {
			"title": "%gitbraid.configuration.title%",
			"properties": {
				"gitbraid.syncDebounceMs": {
					"type": "number",
					"default": 200,
					"description": "Milliseconds to debounce workspace-sync file-change events.",
					"minimum": 0
				},
				"gitbraid.showFloatingWarningOnCommit": {
					"type": "boolean",
					"default": true,
					"description": "Warn when committing a branch that has floating (unassigned) files."
				},
				"gitbraid.singleCommit.confirmAmend": {
					"type": "boolean",
					"default": true,
					"description": "Prompt before amending the existing commit on a branch that is in single-commit mode.  Disable once you trust the behaviour."
				},
				"gitbraid.prDecorationsEnabled": {
					"type": "boolean",
					"default": true,
					"description": "Show branch-assignment color decorations in the file explorer."
				},
				"gitbraid.showPrReviewComments": {
					"type": "boolean",
					"default": true,
					"description": "Show GitHub PR line-level review comments inline in the editor, on the branch a file is assigned to. Requires a stored GitHub token (GitBraid: Set GitHub Token…)."
				},
				"gitbraid.defaultBranchColor": {
					"type": "string",
					"default": "#4ec9b0",
					"description": "Default hex color for newly added stack branches.",
					"pattern": "^#[0-9a-fA-F]{6}$"
				},
				"gitbraid.maxSyncFileSizeKb": {
					"type": "number",
					"default": 10240,
					"description": "Skip sync for files larger than this size (in KB). Set to 0 to disable the limit.",
					"minimum": 0
				},
				"gitbraid.rebaseCheckIntervalMinutes": {
					"type": "number",
					"default": 5,
					"description": "Minutes between background checks for branches behind their parent. Set to 0 to disable the periodic check (the event-driven checks on stack changes still run).",
					"minimum": 0
				},
				"gitbraid.bidirectionalSync": {
					"type": "boolean",
					"default": false,
					"description": "Experimental: copy externally-made edits inside .worktrees/ back into the primary workspace. Leave disabled unless you actively edit worktree directories from a terminal or second window."
				},
				"gitbraid.mcpWriteEnabled": {
					"type": "boolean",
					"default": false,
					"description": "Allow external MCP clients to call write tools (addBranch, assignFile, commitBranch, etc.). When false, only read-only tools are accessible. Requires the MCP server to be running."
				},
				"gitbraid.prHost": {
					"type": "string",
					"enum": [
						"auto",
						"github",
						"gitlab",
						"bitbucket",
						"azure",
						"none"
					],
					"default": "auto",
					"description": "Pull/merge-request host used by Submit Stack. `auto` dispatches by the origin remote (github.com → GitHub, gitlab → GitLab, bitbucket.org → Bitbucket, dev.azure.com / visualstudio.com → Azure DevOps). Override to pin a specific host for self-hosted or ambiguous remotes."
				},
				"gitbraid.suggestImportOnActivate": {
					"type": "boolean",
					"default": false,
					"description": "Offer to import detected stacked tooling (Graphite, git-spr, git-stack, GitButler) when the extension activates."
				},
				"gitbraid.absorbRewritePushed": {
					"type": "boolean",
					"default": false,
					"description": "Allow `Absorb Hunks` to rewrite commits that are already pushed to a remote. Dangerous — leave off unless you understand force-pushing."
				},
				"gitbraid.undoLogMaxEntries": {
					"type": "number",
					"default": 500,
					"minimum": 10,
					"description": "Maximum number of entries retained in the persistent undo log (.worktrees/undo-log.jsonl)."
				},
				"gitbraid.mergeQueuePollSeconds": {
					"type": "number",
					"default": 30,
					"minimum": 5,
					"description": "Polling interval (seconds) used by Merge Stack when waiting for each queued PR to merge."
				},
				"gitbraid.telemetry.enabled": {
					"type": "boolean",
					"default": false,
					"description": "Send anonymous usage counters (command names and stack-shape counts only — never file contents, paths, branch names, or remote URLs). Disabled by default; also requires VS Code's global telemetry setting to be on. No data leaves the machine unless a reporter sink is also configured."
				}
			}
		},
		"languageModelTools": [
			{
				"name": "gitbraid_getStack",
				"displayName": "GitBraid: Get Branch Stack",
				"modelDescription": "Returns the current GitBraid branch stack and its entries, ordered from base to top.",
				"userDescription": "Read the current GitBraid branch stack.",
				"canBeReferencedInPrompt": true,
				"toolReferenceName": "gitbraidGetStack",
				"icon": "$(list-tree)",
				"inputSchema": {
					"type": "object",
					"properties": {},
					"additionalProperties": false
				}
			},
			{
				"name": "gitbraid_getFloatingFiles",
				"displayName": "GitBraid: Get Floating Files",
				"modelDescription": "Returns workspace-relative paths for files that are modified but not yet assigned to any branch in the stack.",
				"userDescription": "List floating (unassigned) files.",
				"canBeReferencedInPrompt": true,
				"toolReferenceName": "gitbraidGetFloatingFiles",
				"icon": "$(warning)",
				"inputSchema": {
					"type": "object",
					"properties": {},
					"additionalProperties": false
				}
			},
			{
				"name": "gitbraid_getBranchStatus",
				"displayName": "GitBraid: Get Branch Status",
				"modelDescription": "Returns staged / unstaged / untracked counts for a branch's worktree.",
				"userDescription": "Inspect the status of a branch in the stack.",
				"canBeReferencedInPrompt": true,
				"toolReferenceName": "gitbraidGetBranchStatus",
				"icon": "$(info)",
				"inputSchema": {
					"type": "object",
					"properties": {
						"branch": {
							"type": "string",
							"description": "The branch name to query."
						}
					},
					"required": [
						"branch"
					],
					"additionalProperties": false
				}
			},
			{
				"name": "gitbraid_addBranch",
				"displayName": "GitBraid: Add Branch to Stack",
				"modelDescription": "Creates a new branch in the stack, parented on the provided base branch, and adds a worktree for it.",
				"userDescription": "Add a branch to the GitBraid stack.",
				"canBeReferencedInPrompt": true,
				"toolReferenceName": "gitbraidAddBranch",
				"icon": "$(git-branch-create)",
				"inputSchema": {
					"type": "object",
					"properties": {
						"name": {
							"type": "string",
							"description": "The git branch name for the new stack entry, e.g. 'feature/docs'."
						},
						"base": {
							"type": "string",
							"description": "The parent branch name, e.g. 'main' or another branch already in the stack."
						},
						"color": {
							"type": "string",
							"description": "Optional hex colour (e.g. '#4ec9b0') for Explorer decorations.",
							"pattern": "^#[0-9a-fA-F]{6}$"
						}
					},
					"required": [
						"name",
						"base"
					],
					"additionalProperties": false
				}
			},
			{
				"name": "gitbraid_assignFile",
				"displayName": "GitBraid: Assign File to Branch",
				"modelDescription": "Assigns a workspace-relative file path to a branch in the stack. Subsequent saves of the file are copied to that branch's worktree.",
				"userDescription": "Assign a file to a GitBraid branch.",
				"canBeReferencedInPrompt": true,
				"toolReferenceName": "gitbraidAssignFile",
				"icon": "$(tag)",
				"inputSchema": {
					"type": "object",
					"properties": {
						"relativePath": {
							"type": "string",
							"description": "Workspace-relative path to the file."
						},
						"branch": {
							"type": "string",
							"description": "The branch to assign the file to."
						}
					},
					"required": [
						"relativePath",
						"branch"
					],
					"additionalProperties": false
				}
			},
			{
				"name": "gitbraid_assignHunk",
				"displayName": "GitBraid: Assign Hunk to Branch",
				"modelDescription": "Assigns a specific diff hunk within a file to a branch, identified by its 0-based index in the unified diff output.",
				"userDescription": "Assign a specific hunk to a GitBraid branch.",
				"canBeReferencedInPrompt": true,
				"toolReferenceName": "gitbraidAssignHunk",
				"icon": "$(diff-single)",
				"inputSchema": {
					"type": "object",
					"properties": {
						"relativePath": {
							"type": "string",
							"description": "Workspace-relative path to the file containing the hunk."
						},
						"hunkIndex": {
							"type": "integer",
							"minimum": 0,
							"description": "Zero-based hunk index (from git diff output)."
						},
						"branch": {
							"type": "string",
							"description": "The branch to assign the hunk to."
						}
					},
					"required": [
						"relativePath",
						"hunkIndex",
						"branch"
					],
					"additionalProperties": false
				}
			},
			{
				"name": "gitbraid_getStackDiagram",
				"displayName": "GitBraid: Get Stack Diagram",
				"modelDescription": "Returns an ASCII tree diagram of the current branch stack, showing parent-child relationships. Useful for including in PR descriptions.",
				"userDescription": "Get an ASCII diagram of the branch stack.",
				"canBeReferencedInPrompt": true,
				"toolReferenceName": "gitbraidGetStackDiagram",
				"icon": "$(type-hierarchy)",
				"inputSchema": {
					"type": "object",
					"properties": {},
					"additionalProperties": false
				}
			},
			{
				"name": "gitbraid_assignGlob",
				"displayName": "GitBraid: Assign Files by Glob",
				"modelDescription": "Assigns all workspace files matching a glob pattern to a branch. Use this for bulk assignment of related files (e.g. 'src/auth/**' to 'feature/auth').",
				"userDescription": "Assign files matching a glob pattern to a branch.",
				"canBeReferencedInPrompt": true,
				"toolReferenceName": "gitbraidAssignGlob",
				"icon": "$(filter)",
				"inputSchema": {
					"type": "object",
					"properties": {
						"pattern": {
							"type": "string",
							"description": "Glob pattern relative to workspace root, e.g. 'src/auth/**'"
						},
						"branch": {
							"type": "string",
							"description": "Branch name to assign the matched files to"
						}
					},
					"required": [
						"pattern",
						"branch"
					],
					"additionalProperties": false
				}
			},
			{
				"name": "gitbraid_commitBranch",
				"displayName": "GitBraid: Commit Branch",
				"modelDescription": "Stages all tracked changes in a branch's worktree and creates a commit. Fails if the branch's worktree has no changes.",
				"userDescription": "Commit the current changes on a GitBraid branch.",
				"canBeReferencedInPrompt": true,
				"toolReferenceName": "gitbraidCommitBranch",
				"icon": "$(check)",
				"inputSchema": {
					"type": "object",
					"properties": {
						"branch": {
							"type": "string",
							"description": "The branch to commit."
						},
						"message": {
							"type": "string",
							"minLength": 1,
							"description": "The commit message."
						}
					},
					"required": [
						"branch",
						"message"
					],
					"additionalProperties": false
				}
			}
		],
		"keybindings": [
			{
				"command": "gitbraid.addStackBranch",
				"key": "ctrl+alt+b",
				"mac": "cmd+alt+b"
			},
			{
				"command": "gitbraid.assignFile",
				"key": "ctrl+alt+a",
				"mac": "cmd+alt+a",
				"when": "editorTextFocus || explorerViewletFocus"
			},
			{
				"command": "gitbraid.unassignFile",
				"key": "ctrl+alt+u",
				"mac": "cmd+alt+u",
				"when": "editorTextFocus || explorerViewletFocus"
			},
			{
				"command": "gitbraid.assignHunk",
				"key": "ctrl+alt+h",
				"mac": "cmd+alt+h",
				"when": "editorTextFocus"
			},
			{
				"command": "gitbraid.routeHunks",
				"key": "ctrl+alt+r",
				"mac": "cmd+alt+r",
				"when": "editorTextFocus"
			},
			{
				"command": "gitbraid.openResolvedAtTop",
				"key": "ctrl+alt+t",
				"mac": "cmd+alt+t",
				"when": "editorTextFocus"
			},
			{
				"command": "gitbraid.focusStackView",
				"key": "ctrl+alt+s",
				"mac": "cmd+alt+s"
			},
			{
				"command": "gitbraid.pushStack",
				"key": "ctrl+alt+shift+p",
				"mac": "cmd+alt+shift+p"
			},
			{
				"command": "gitbraid.rebaseBranch",
				"key": "ctrl+alt+shift+r",
				"mac": "cmd+alt+shift+r"
			},
			{
				"command": "gitbraid.undoLastAssignment",
				"key": "ctrl+alt+z",
				"mac": "cmd+alt+z"
			},
			{
				"command": "gitbraid.redoLastAssignment",
				"key": "ctrl+alt+shift+z",
				"mac": "cmd+alt+shift+z"
			},
			{
				"command": "gitbraid.moveBranchUp",
				"key": "alt+up",
				"when": "focusedView == gitbraid.stackView && viewItem == branch"
			},
			{
				"command": "gitbraid.moveBranchDown",
				"key": "alt+down",
				"when": "focusedView == gitbraid.stackView && viewItem == branch"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run lint && npm run compile",
		"build": "node esbuild.js",
		"compile": "node esbuild.js",
		"package": "npx vsce package --no-dependencies",
		"install-vsix": "npm run package && code --install-extension gitbraid-$(npm pkg get version | tr -d '\"').vsix",
		"watch": "npm run build -- --watch",
		"pretest": "node scripts/setup-test-fixture.js",
		"test": "vscode-test --coverage",
		"lint": "eslint \"src/**/*.ts\"",
		"refresh": "npm run test && npm run install-vsix"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"minimatch": "^9.0.9"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "^2.11.0",
		"@swc-node/register": "^1.10.9",
		"@types/mocha": "^10.0.10",
		"@types/node": "^20",
		"@types/vscode": "^1.95.0",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"@typescript-eslint/typescript-estree": "^8.59.0",
		"@vscode/test-cli": "^0.0.11",
		"@vscode/test-electron": "^2.4.1",
		"@vscode/vsce": "^2.25.0",
		"esbuild": "^0.28.0",
		"eslint": "^8.57.1",
		"eslint-plugin-promise": "^7.2.1",
		"mocha": "^7.2.0",
		"typescript": "^5.7.2"
	}
}
